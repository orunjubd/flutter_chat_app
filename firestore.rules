rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function convPath(id) { return /databases/$(database)/documents/conversations/$(id); }

    // ---------- users ----------
    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /groupCallHistory/{id} { allow read, write: if signedIn() && request.auth.uid == uid; }
      match /conversationSettings/{id} { allow read, write: if signedIn() && request.auth.uid == uid; }

      // Contact data (requires the migration; harmless until then).
      match /private/email {
        allow read: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(uid)).data.get('shareEmailWithGroupMembers', false) == true);
        allow write: if signedIn() && request.auth.uid == uid;
      }
      match /private/phone {
        allow read: if signedIn() && (request.auth.uid == uid
          || get(/databases/$(database)/documents/users/$(uid)).data.get('sharePhoneNumberWithGroupMembers', false) == true);
        allow write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- presence / typing ----------
    match /presence/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }
    match /typing/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---------- conversations ----------
    match /conversations/{cid} {
      function isMember() { return signedIn() && request.auth.uid in resource.data.participantIds; }
      function isGroup(d) { return d.get('type', 'direct') == 'group'; }
      function isAdmin() { return request.auth.uid in resource.data.get('adminIds', []); }
      function hasPerm(p) {
        return isAdmin() || p in resource.data.get('permissions', {}).get(request.auth.uid, []);
      }
      function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

      allow read: if isMember();

      allow create: if signedIn()
        && request.auth.uid in request.resource.data.participantIds
        && (isGroup(request.resource.data)
            ? (request.resource.data.createdBy == request.auth.uid
               && request.resource.data.adminIds == [request.auth.uid]
               && request.resource.data.participantIds.size() <= 256)
            : request.resource.data.participantIds.size() == 2);

      allow update: if isMember() && (
        // direct chats: membership never changes
        (!isGroup(resource.data)
          && request.resource.data.participantIds == resource.data.participantIds)
        // unread counters: any member
        || changed().hasOnly(['unreadCounts'])
        // message preview: members who can send
        || (changed().hasOnly(['lastMessage', 'lastMessageTime', 'updatedAt', 'lastSenderName', 'unreadCounts'])
            && (!isGroup(resource.data) || hasPerm('send')))
        // admins: everything
        || (isGroup(resource.data) && isAdmin())
        // leave: remove only yourself
        || (isGroup(resource.data)
            && !(request.auth.uid in request.resource.data.participantIds)
            && resource.data.participantIds.toSet().difference([request.auth.uid].toSet())
                 == request.resource.data.participantIds.toSet())
        // add members: only grow the list
        || (isGroup(resource.data) && hasPerm('addMembers')
            && request.resource.data.participantIds.hasAll(resource.data.participantIds)
            && changed().hasOnly(['participantIds', 'joinedAt', 'permissions', 'unreadCounts',
                                  'lastMessage', 'lastMessageTime', 'updatedAt', 'lastSenderName']))
        // edit info
        || (isGroup(resource.data) && hasPerm('editInfo')
            && changed().hasOnly(['name', 'description', 'avatarUrl',
                                  'lastMessage', 'lastMessageTime', 'updatedAt', 'lastSenderName']))
      );
      allow delete: if false;

      // ---------- messages ----------
      match /messages/{mid} {
        function conv() { return get(convPath(cid)).data; }
        function member() { return signedIn() && request.auth.uid in conv().participantIds; }
        function mayDeleteAll() {
          return resource.data.senderId == request.auth.uid
            || request.auth.uid in conv().get('adminIds', [])
            || 'deleteMessages' in conv().get('permissions', {}).get(request.auth.uid, []);
        }

        allow read: if member();

        allow create: if signedIn() && (
          // normal message: member who may send
          (request.resource.data.senderId == request.auth.uid
            && request.auth.uid in conv().participantIds
            && (conv().get('type', 'direct') != 'group'
                || request.auth.uid in conv().get('adminIds', [])
                || 'send' in conv().get('permissions', {}).get(request.auth.uid, [])))
          // group notices written in the same batch as the membership change
          || (request.resource.data.type == 'group_system'
              && request.resource.data.actorId == request.auth.uid
              && ((exists(convPath(cid)) && request.auth.uid in conv().participantIds)
                  || request.auth.uid in getAfter(convPath(cid)).data.participantIds))
          // call notices from the caller
          || (request.resource.data.type == 'call_system'
              && request.resource.data.senderId == request.auth.uid
              && request.auth.uid in conv().participantIds)
        );

        allow update: if member()
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['readBy', 'reactions', 'deletedBy', 'deletedForEveryone', 'deletedAt', 'removedFor'])
          && (!('deletedForEveryone' in request.resource.data.diff(resource.data).affectedKeys())
              || mayDeleteAll());

        allow delete: if false;
      }
    }

    // ---------- 1:1 calls ----------
    match /calls/{id} {
      allow create: if signedIn() && request.auth.uid == request.resource.data.callerId;
      allow get, list: if signedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId);
      allow update: if signedIn()
        && (request.auth.uid == resource.data.callerId || request.auth.uid == resource.data.calleeId)
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.calleeId == resource.data.calleeId;
      allow delete: if false;
    }
    match /callHistory/{id} {
      allow read, create, update: if signedIn()
        && (request.auth.uid == request.resource.data.get('callerId', resource.data.callerId)
            || request.auth.uid == request.resource.data.get('calleeId', resource.data.calleeId));
      allow delete: if false;
    }

    // ---------- group calls ----------
    match /groupCalls/{id} {
      allow create: if signedIn()
        && request.auth.uid == request.resource.data.callerId
        && request.auth.uid in request.resource.data.participantIds;
      allow get: if signedIn() && request.auth.uid in resource.data.participantIds;
      allow list: if signedIn()
        && (request.auth.uid in resource.data.participantIds
            || request.auth.uid in resource.data.invitedIds);
      allow update: if signedIn()
        && request.auth.uid in resource.data.participantIds
        && request.resource.data.callerId == resource.data.callerId
        && request.resource.data.participantIds == resource.data.participantIds;
      allow delete: if false;
    }

    // everything else is denied
    match /{document=**} { allow read, write: if false; }
  }
}